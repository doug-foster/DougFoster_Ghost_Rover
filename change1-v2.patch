 void taskBuildOperData(void * pvParameters) {
     while(true) {
+        const int64_t startUs = esp_timer_get_time();           // Diagnostics: how long does one GNSS build take?
         buildOperData();
+        const uint32_t elapsedUs = (uint32_t)(esp_timer_get_time() - startUs);
